# Production Environment Variables
ENVIRONMENT=production
LOG_LEVEL=info
API_URL=https://ai-dashboard-api.your-domain.com
WS_URL=wss://ai-dashboard-ws.your-domain.com
ARGO_SERVER=http://argo-server.argo-ai-prod.svc.cluster.local:2746
MINIO_ENDPOINT=minio.argo-ai-prod.svc.cluster.local:9000
# Production-specific
ENABLE_METRICS=true
ENABLE_TRACING=true
RATE_LIMIT=1000

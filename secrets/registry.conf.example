# Container Registry Configuration Example
# Copy this file to registry.conf and update with your values

# Registry URL and organization
# Examples:
#   - Docker Hub: docker.io/myusername
#   - Quay.io: quay.io/myorg
#   - Private registry: registry.example.com/myproject
#   - OpenShift internal: image-registry.openshift-image-registry.svc:5000/myproject
REGISTRY_URL=quay.io
REGISTRY_ORG=your-org

# Optional: Registry credentials (if needed for push operations)
# Uncomment and fill in if your registry requires authentication
# REGISTRY_USERNAME=your-username
# REGISTRY_PASSWORD=your-password

# Optional: Override image names (defaults to ai-workflow-dashboard-backend/frontend)
# BACKEND_IMAGE_NAME=ai-workflow-dashboard-backend
# FRONTEND_IMAGE_NAME=ai-workflow-dashboard-frontend
